# ─── Contracts deploy (packages/contracts) ───────────────────────────────────
# Hex private key WITHOUT 0x prefix optional — forge accepts 0x-prefixed too.
# NEVER commit real keys.
PRIVATE_KEY=
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
# Set to true to also deploy AgentTillFactory
DEPLOY_FACTORY=false

# ─── Web (apps/web) — copy to apps/web/.env.local ────────────────────────────
# WalletConnect Cloud project id (public client id). Optional; injected wallets work without it.
NEXT_PUBLIC_WC_PROJECT_ID=
# Deployed AgentTill address. Leave unset for demo/mock mode.
NEXT_PUBLIC_AGENT_TILL_ADDRESS=
# Arc USDC ERC-20 (6 decimals). Default is Arc canonical address.
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# testnet | mainnet
NEXT_PUBLIC_DEFAULT_NETWORK=testnet
